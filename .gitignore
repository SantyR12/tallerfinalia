__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Entornos virtuales y variables de entorno
.venv/
venv/
env/
.env

# Editores y sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db
